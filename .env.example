# =====================================================================
# Multi-Agent Orchestrator — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

# --- Application ---
APP_ENV=local                      # local | development | staging | production
APP_NAME=multi-agent-orchestrator
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins (use explicit URLs in production)
CORS_ORIGINS=http://localhost:3000
# Maximum accepted request body size for chat endpoints, in characters
MAX_MESSAGE_LENGTH=8000

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=                   # optional: for proxies / Azure-compatible gateways
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# DEV/LOAD-TEST ONLY: deterministic fake LLM instead of OpenAI (never in production)
LLM_FAKE_MODE=false

# --- PostgreSQL ---
# Application user (has DML rights on app schema). Change the port to match your setup.
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5434/orchestrator
# Read-only user used exclusively by the AI database agent (see docs/SECURITY.md)
DATABASE_RO_URL=postgresql+asyncpg://orchestrator_ro:orchestrator_ro@localhost:5434/orchestrator
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=10000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Bootstrap admin API key for local development (seeded by scripts/seed_local.py)
BOOTSTRAP_ADMIN_API_KEY=local-admin-key-change-me
# Fail-open (true) or fail-closed (false) if Redis is unavailable for rate limiting
RATE_LIMIT_FAIL_OPEN=false

# --- Routing policy ---
ROUTER_CONFIDENCE_THRESHOLD=0.80
ROUTER_FALLBACK_AGENT=general

# --- Memory ---
MEMORY_SHORT_TERM_WINDOW=20
MEMORY_SEMANTIC_TOP_K=5
MEMORY_SEMANTIC_MIN_SCORE=0.30
MEMORY_EXTRACTION_ENABLED=true

# --- Search tool (external search API; see docs/ARCHITECTURE.md) ---
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=                   # empty => search tool reports "unavailable", never fabricates
SEARCH_TIMEOUT_SECONDS=8
SEARCH_MAX_RETRIES=2

# --- Database agent policy ---
DB_AGENT_ALLOWED_TABLES=documents,faqs
DB_AGENT_MAX_ROWS=50
DB_AGENT_QUERY_TIMEOUT_MS=5000
DB_AGENT_ALLOWED_ROLES=admin,analyst

# --- Rate limiting (requests per window) ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
RATE_LIMIT_IP_PER_MINUTE=120

# --- Cost control (USD per 1M tokens: input,output) ---
LLM_PRICING={"gpt-4o-mini": [0.15, 0.60], "text-embedding-3-small": [0.02, 0.0]}

# --- Observability ---
OTEL_SERVICE_NAME=multi-agent-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://localhost:4318 (empty => tracing disabled)
OTEL_TRACES_ENABLED=false
METRICS_ENABLED=true
